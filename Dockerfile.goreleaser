# Used by GoReleaser to build the container image from the already-built
# binary (see .goreleaser.yml). Not used for a normal `docker build .` —
# for that, use ./Dockerfile if one exists, or `go build ./cmd/topotrace`.
FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S topotrace && adduser -S topotrace -G topotrace

COPY topotrace /usr/local/bin/topotrace

USER topotrace
EXPOSE 8080 9100
ENTRYPOINT ["/usr/local/bin/topotrace"]
