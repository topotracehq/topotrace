# Copy to /etc/muster-agent.env (chmod 600 if MUSTER_TOKEN is set --
# it's a shared secret, EnvironmentFile is read by systemd as root before
# dropping to User=muster-agent, so 600/root:root is safe and correct).
MUSTER_HOST=muster.example.internal
MUSTER_PORT=9090
#MUSTER_TOKEN=some-shared-secret
#MUSTER_HOST_NAME=webbox01
