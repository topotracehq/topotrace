# Copy to /etc/topotrace-agent.env (chmod 600 if TOPOTRACE_TOKEN is set --
# it's a shared secret, EnvironmentFile is read by systemd as root before
# dropping to User=topotrace-agent, so 600/root:root is safe and correct).
TOPOTRACE_HOST=topotrace.example.internal
TOPOTRACE_PORT=9090
#TOPOTRACE_TOKEN=some-shared-secret
#TOPOTRACE_HOST_NAME=webbox01
