# Muster inventory server -- systemd unit for a standalone Linux
# VM/bare-metal install (the non-Kubernetes counterpart to charts/muster).
#
# Install with deploy/systemd/install.sh, or by hand: see
# deploy/systemd/README.md.

[Unit]
Description=Muster inventory server
Documentation=file:///var/lib/muster/README.md
After=network-online.target
Wants=network-online.target
# Using a local Postgres instead of the default JSON-snapshot store?
# Uncomment these two so systemd starts Postgres first:
# After=postgresql.service
# Wants=postgresql.service

[Service]
Type=simple
User=muster
Group=muster
WorkingDirectory=/var/lib/muster

# "-" prefix: don't fail to start if the file is missing -- every setting
# it can carry has a built-in default (see muster-server.sh), so a
# service started with zero config still comes up listening on
# :8080/:9090 with no auth, the same permissive-by-default posture
# `go run ./cmd/muster` has with no flags.
EnvironmentFile=-/etc/muster/muster.env

ExecStart=/usr/local/bin/muster-server.sh
Restart=on-failure
RestartSec=5s

# --- sandboxing -- narrow but not aggressive: this still needs to bind
# two TCP ports and read/write one data directory, nothing exotic. ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/muster
# Binding to ports >1024 (:8080, :9090 by default) needs no special
# capability; if you lower MUSTER_API_ADDR/MUSTER_INGEST_ADDR below
# 1024, also add: AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
